<?xml version='1.0' encoding='utf-8'?>
<modDesc descVersion="111">
    <author>GOLDMATR1X</author>
    <version>1.3.3.3</version>
    <title>
        <en>KUHN ESPRO 6000 RC Pro</en>
    </title>
    <description>
        <en>Professional ESPRO 6000 RC Pro upgrade by GOLDMATR1X. Includes 25 km/h working speed, 5,500 L, 7,500 L and 10,000 L seed/fertiliser capacities, expanded paint finishes, Special Editions, chained automatic bag/pallet refilling, Pro work lighting, enhanced operating sounds, a large refill pickup radius, three selectable Trelleborg wheel layouts and selectable rim finishes. No additional decal package is included. Created by GOLDMATR1X.</en>
    </description>
    <iconFilename>icon_KuhnEspro6000RCPro.dds</iconFilename>
    <multiplayer supported="true" />
    <l10n>
        <text name="input_ESPRO_AUTO_REFILL_TOGGLE">
            <en>Toggle Auto Refill</en>
        </text>
        <text name="espro_wheelSetup"><en>Wheel Setup</en></text>
        <text name="espro_wheelFactory"><en>Factory Twin Pack</en></text>
        <text name="espro_wheelSingle"><en>Single Pack</en></text>
        <text name="espro_wheelFullTwin"><en>Full Twin Pack</en></text>
        <text name="espro_rimColor"><en>Rim Finish</en></text>
        <text name="espro_rimFactory"><en>Factory</en></text>
        <text name="espro_rimChrome"><en>Chrome</en></text>
        <text name="espro_rimWhite"><en>White</en></text>
        <text name="espro_rimBlack"><en>Black</en></text>
    </l10n>
    <actions>
        <action name="ESPRO_AUTO_REFILL_TOGGLE" category="VEHICLE" axisType="HALF" ignoreComboMask="false" />
    </actions>
    <inputBinding>
        <actionBinding action="ESPRO_AUTO_REFILL_TOGGLE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_r" />
        </actionBinding>
    </inputBinding>
    <specializations>
        <specialization name="esproAutoRefill" className="EsproAutoRefill" filename="scripts/EsproAutoRefill.lua" />
    </specializations>
    <vehicleTypes>
        <type name="esproFertilizingSowingMachine" parent="fertilizingSowingMachine" className="Vehicle" filename="$dataS/scripts/vehicles/Vehicle.lua">
            <specialization name="esproAutoRefill" />
        </type>
    </vehicleTypes>
    <storeItems>
        <storeItem xmlFilename="espro6000RC.xml" />
    </storeItems>
</modDesc>
